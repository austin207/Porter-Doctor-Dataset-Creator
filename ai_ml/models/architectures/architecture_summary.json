  "router": {
    "deployment_target": "esp32_s3",
    "hidden_layers": [
      {
        "activation": "relu",
        "units": 32
      },
      {
        "activation": "relu",
        "units": 16
      }
    ],
    "input_dim": 17,
    "input_features": [
      "power_voltage_drop",
      "power_current_peak",
      "power_regulator_instability_score",
      "motor_rpm_error_peak",
      "motor_vibration_score",
      "motor_current_response_score",
