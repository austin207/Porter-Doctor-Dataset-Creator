    "driver_enable_right",
    "current_left_a",
    "current_right_a",
    "battery_voltage_v",
    "telemetry_valid",
    "telemetry_age_ms"
  ],
  "n_estimators": 100,
  "max_depth": 8,
  "random_state": 7
}
