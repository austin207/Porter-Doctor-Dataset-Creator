{
  "model_name": "power_expert",
  "purpose": "Classify power-system faults from battery voltage, current, and power telemetry.",
  "input_csvs": [
    "ai_ml/datasets/power_expert/raw/healthy_run_001.csv"
  ],
  "artifact_dir": "ai_ml/models/power_expert/artifacts",
