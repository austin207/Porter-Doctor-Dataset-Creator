{
  "model_name": "power_expert",
  "purpose": "Classify power-system faults from battery voltage, current, and power telemetry.",
  "input_csvs": [
    "ai_ml/datasets/merged/power_expert_raw_merged.csv"
  ],
  "artifact_dir": "ai_ml/models/power_expert/artifacts",
  "label_column": "fault_label",
  "feature_columns": [
    "fault_active",
    "severity",
    "battery_voltage_v",
    "battery_current_a",
    "battery_power_w"
  ],
  "n_estimators": 100,
  "max_depth": 8,
  "random_state": 7,
  "hidden_layers": [
    32,
    16
  ],
  "learning_rate": 0.001,
  "batch_size": 16,
  "epochs": 120
}
