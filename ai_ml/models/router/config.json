{
  "model_name": "moe_router",
  "purpose": "Route a telemetry window to the top subsystem experts.",
  "input_csvs": [
    "ai_ml/router_dataset_builder/output/router_dataset.csv"
  ],
  "artifact_dir": "ai_ml/models/router/artifacts",
  "label_column": "target_expert",
