/* ESP32 DevKitC WROOM overlay for Power Expert Logger */
/* INA226: VCC->3V3, GND->GND, SDA->GPIO21, SCL->GPIO22 */
/* INA226 path: Battery+ -> IN+, IN- -> MotorDriver VIN+ */
/* SD: SCK GPIO18, MISO GPIO19, MOSI GPIO23, CS GPIO25 */

#include <zephyr/dt-bindings/pinctrl/esp32-pinctrl.h>

&pinctrl {
    porter_i2c0_default: porter_i2c0_default {
        group1 {
            pinmux = <I2C0_SDA_GPIO21>,
                     <I2C0_SCL_GPIO22>;
            bias-pull-up;
            drive-open-drain;
            output-high;
        };
    };

    porter_spim2_default: porter_spim2_default {
        group1 {
            pinmux = <SPIM2_MISO_GPIO19>,
                     <SPIM2_MOSI_GPIO23>,
                     <SPIM2_SCLK_GPIO18>,
                     <SPIM2_CSEL_GPIO25>;
        };
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&porter_i2c0_default>;
    pinctrl-names = "default";

    power_sensor: ina226@40 {
        compatible = "ti,ina226";
        reg = <0x40>;
        shunt-resistor-micro-ohms = <100000>;
    };
};

&spi2 {
    status = "okay";
    cs-gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
    pinctrl-0 = <&porter_spim2_default>;
    pinctrl-names = "default";

    sdhc0: sdhc@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        status = "okay";
        spi-max-frequency = <8000000>;

        mmc {
            compatible = "zephyr,sdmmc-disk";
            disk-name = "SD";
            status = "okay";
        };
    };
};

/ {
    aliases {
        power-sensor = &power_sensor;
    };
};
